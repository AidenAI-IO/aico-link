#!/bin/sh
set -eu

gadget_dir=${AICO_USB_GADGET_DIR:-/sys/kernel/config/usb_gadget/aico_hid}
udc_file=${AICO_USB_UDC_FILE:-${gadget_dir}/UDC}
udc_name=${AICO_USB_UDC_NAME:-ffb00000.usb}
udc_state_file=${AICO_USB_UDC_STATE_FILE:-/sys/class/udc/${udc_name}/state}
usb_net_class=${AICO_USB_NET_CLASS_PATH:-/sys/class/net/usb0}
lease_file=${AICO_USB_LEASE_FILE:-/run/aico/dnsmasq-usb0.leases}
lock_dir=${AICO_USB_LOCK_DIR:-/run/aico_dynamic_keyboard.lock}
grace_file=${AICO_USB_GRACE_FILE:-/run/aico_dynamic_keyboard.grace}
refresh_state_file=${AICO_USB_REFRESH_STATE_FILE:-/run/aico_usb_ecm_watchdog.state}
carrier_file=${AICO_USB_CARRIER_FILE:-${usb_net_class}/carrier}
rx_packets_file=${AICO_USB_RX_PACKETS_FILE:-${usb_net_class}/statistics/rx_packets}
interval=${USB_ECM_PROBE_INTERVAL:-5}
# Resetting the composite gadget drops the HID session too, so a stall has to
# be confirmed over minutes rather than a single unanswered ARP burst.  A
# desktop host can legitimately ignore ARP probes (firewall, NDP-only stack, a
# renewing DHCP client) while the ECM link is perfectly healthy.
threshold=${USB_ECM_FAIL_THRESHOLD:-12}
cooldown=${USB_ECM_COOLDOWN:-300}
# A profile switch the board made itself (aico-dynamic-keyboard) re-enumerates
# the phone, and iOS sometimes leaves the new ECM link down: no DHCP, no ARP.
# Right after such a switch the host is known to have been talking a moment
# ago, so a few failed probes are enough evidence, and waiting the idle
# threshold would cut the phone off for minutes. The switch is recognised by
# the grace deadline it publishes.
replug_threshold=${USB_ECM_REPLUG_FAIL_THRESHOLD:-2}
replug_window=${USB_ECM_REPLUG_WINDOW:-60}

hosts() {
    {
        awk '$3 ~ /^192\.168\.42\./ && $3 != "192.168.42.1" {print $3}' \
            "${lease_file}" 2>/dev/null
        ip -4 neigh show dev usb0 2>/dev/null \
            | awk '$1 ~ /^192\.168\.42\./ && $1 != "192.168.42.1" {print $1}'
    } | sort -u
}

grace_active() {
    until=$(cat "${grace_file}" 2>/dev/null || echo 0)
    case "${until}" in ''|*[!0-9]*) until=0 ;; esac
    [ "${until}" -gt "$(date +%s)" ]
}

probe() {
    # A missing prober says nothing about the link, so it must never be able to
    # justify tearing the gadget down.
    command -v arping >/dev/null 2>&1 || return 2
    found=0
    for host in $(hosts); do
        found=1
        arping -q -c 2 -w 2 -I usb0 "${host}" && return 0
    done
    [ "${found}" -eq 1 ] && return 1
    return 2
}

carrier_up() {
    [ "$(cat "${carrier_file}" 2>/dev/null || echo 0)" = 1 ]
}

read_rx_packets() {
    rx=$(cat "${rx_packets_file}" 2>/dev/null || echo '')
    case "${rx}" in
        ''|*[!0-9]*) echo '' ;;
        *) echo "${rx}" ;;
    esac
}

acquire_lock() {
    if mkdir "${lock_dir}" 2>/dev/null; then
        echo $$ >"${lock_dir}/pid"
        return 0
    fi

    owner=$(cat "${lock_dir}/pid" 2>/dev/null || true)
    case "${owner}" in
        ''|*[!0-9]*) ;;
        *)
            if ! kill -0 "${owner}" 2>/dev/null; then
                rm -f "${lock_dir}/pid"
                rmdir "${lock_dir}" 2>/dev/null || true
                if mkdir "${lock_dir}" 2>/dev/null; then
                    echo $$ >"${lock_dir}/pid"
                    return 0
                fi
            fi
            ;;
    esac
    return 1
}
release_lock() {
    rm -f "${lock_dir}/pid"
    rmdir "${lock_dir}" 2>/dev/null || true
}

write_refresh_state() {
    reason=$1
    result=$2
    started_at=$3
    detail=$4
    state_dir=$(dirname "${refresh_state_file}")
    state_tmp=${refresh_state_file}.tmp.$$
    mkdir -p "${state_dir}"
    {
        printf 'last_refresh_epoch=%s\n' "$(date +%s)"
        printf 'last_refresh_reason=%s\n' "${reason}"
        printf 'last_refresh_result=%s\n' "${result}"
        printf 'last_refresh_started_epoch=%s\n' "${started_at}"
        printf 'last_refresh_detail=%s\n' "${detail}"
        printf 'udc_state=%s\n' "$(cat "${udc_state_file}" 2>/dev/null || true)"
        printf 'gadget_udc=%s\n' "$(cat "${udc_file}" 2>/dev/null || true)"
    } >"${state_tmp}"
    chmod 0644 "${state_tmp}"
    mv -f "${state_tmp}" "${refresh_state_file}"
}

reset_composite() (
    reason=${1:-manual refresh}
    started_at=$(date +%s)
    acquire_lock || exit 1
    trap release_lock EXIT HUP INT TERM
    grace_active && exit 0
    write_refresh_state "${reason}" started "${started_at}" "reset started"
    if [ ! -w "${udc_file}" ]; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC control is not writable"
        exit 1
    fi
    if ! printf '\n' >"${udc_file}"; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC unbind failed"
        exit 1
    fi
    sleep 1
    if ! printf '%s\n' "${udc_name}" >"${udc_file}"; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC rebind failed"
        exit 1
    fi
    elapsed=0
    while [ "${elapsed}" -lt 10 ]; do
        [ "$(cat "${udc_state_file}" 2>/dev/null || true)" = configured ] && break
        sleep 1
        elapsed=$((elapsed + 1))
    done
    if [ "$(cat "${udc_state_file}" 2>/dev/null || true)" != configured ]; then
        write_refresh_state "${reason}" failed "${started_at}" "UDC did not reach configured"
        exit 1
    fi
    if [ -d "${usb_net_class}" ]; then
        ip link set dev usb0 up || true
        ip address replace 192.168.42.1/24 dev usb0 || true
    fi
    write_refresh_state "${reason}" ok "${started_at}" "reset complete"
)

case "${1:-watch}" in
    refresh)
        reset_composite "manual refresh"
        exit $?
        ;;
    watch)
        ;;
    *)
        echo "Usage: $0 [watch|refresh]" >&2
        exit 2
        ;;
esac

# grace_deadline prints the published grace deadline, or 0.
grace_deadline() {
    until=$(cat "${grace_file}" 2>/dev/null || echo 0)
    case "${until}" in ''|*[!0-9]*) until=0 ;; esac
    echo "${until}"
}

failures=0
last_reset=0
last_rx=$(read_rx_packets)
# Seconds since the epoch until which a failed probe counts against the short
# post-switch threshold; 0 outside such a window.
# A watchdog (re)started during a switch's grace period still owes that switch
# its window; an old deadline yields a window already in the past.
seen_grace=$(grace_deadline)
replug_until=$((seen_grace + replug_window))
while :; do
    sleep "${interval}"
    [ "$(cat "${udc_state_file}" 2>/dev/null || true)" = configured ] || {
        failures=0
        continue
    }
    grace=$(grace_deadline)
    if [ "${grace}" != "${seen_grace}" ]; then
        # A new profile switch: once its grace ends, watch the link closely.
        seen_grace=${grace}
        replug_until=$((grace + replug_window))
    fi
    grace_active && { failures=0; continue; }
    limit=${threshold}
    in_replug_window=0
    if [ "$(date +%s)" -lt "${replug_until}" ]; then
        limit=${replug_threshold}
        in_replug_window=1
    fi

    # No carrier means no host is attached to ECM at all.  That is not a stall,
    # and resetting the gadget over it would churn a perfectly idle device.
    if [ -e "${carrier_file}" ] && ! carrier_up; then
        failures=0
        continue
    fi

    # Inbound traffic is proof the session is alive, whatever ARP does.  This
    # is the signal that keeps a healthy desktop host from being torn down.
    rx=$(read_rx_packets)
    if [ -n "${rx}" ] && [ -n "${last_rx}" ] && [ "${rx}" != "${last_rx}" ]; then
        last_rx=${rx}
        failures=0
        continue
    fi
    [ -n "${rx}" ] && last_rx=${rx}

    if probe; then
        failures=0
        continue
    else
        result=$?
    fi
    [ "${result}" -eq 2 ] && { failures=0; continue; }
    failures=$((failures + 1))
    logger -t aico-usb-ecm-watchdog "ECM probe failed (${failures}/${limit})"
    now=$(date +%s)
    # The cooldown keeps an idle reset loop from churning the gadget. A link
    # lost to a switch the board made is not that loop; repair it every time.
    if [ "${failures}" -ge "${limit}" ] && \
        { [ "${in_replug_window}" -eq 1 ] || [ $((now - last_reset)) -ge "${cooldown}" ]; }; then
        logger -t aico-usb-ecm-watchdog "resetting stalled composite gadget"
        reset_composite "ECM stall" || logger -t aico-usb-ecm-watchdog "composite reset failed"
        last_reset=${now}
        failures=0
        # The reset published no grace deadline; do not repeat it at once.
        replug_until=0
    fi
done
