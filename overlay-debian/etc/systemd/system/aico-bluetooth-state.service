[Unit]
Description=Bind persistent Aico Link BlueZ state
Requires=aico-userdata-migrate.service
After=aico-userdata-migrate.service
Before=bluetooth.service

[Service]
Type=oneshot
ExecStart=/usr/lib/aico/aico-bluetooth-state
RemainAfterExit=yes
TimeoutStartSec=10s

[Install]
WantedBy=multi-user.target
