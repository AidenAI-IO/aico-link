#!/bin/sh
# Apply the LAN access switch and the device password, set in the Agent
# settings, to SSH and the aico login account.
#
# - The device password becomes the aico password, so the web terminal and
#   SSH use it. Without one (never set, or cleared) the account is locked:
#   no password logs in to a shell, not even the image's factory one, until
#   the owner sets a device password.
# - sshd accepts LAN sources only while LAN access is on AND the device
#   password is applied to the account. Otherwise it refuses every source
#   outside the USB link and the board itself.
#
# /run is volatile and /etc/shadow is reset by OTA, so this runs on every boot
# before sshd, and again from Config Web whenever the state changes.
set -eu

ENABLED_FILE=${AICO_LAN_ACCESS_FILE:-/userdata/system/lan-access-enabled}
PASSWORD_FILE=${AICO_DEVICE_PASSWORD_FILE:-/userdata/system/device-password}
SSHD_RULE_DIR=${AICO_SSHD_RULE_DIR:-/run/aico/sshd}
ACCOUNT=${AICO_DEVICE_ACCOUNT:-aico}
USERMOD=${AICO_USERMOD_BIN:-usermod}
SYSTEMCTL=${AICO_SYSTEMCTL_BIN:-systemctl}
USB_SUBNET=${AICO_USB_SUBNET:-192.168.42.0/24}
# The boot unit sets AICO_SSHD_RELOAD=no-block: ssh.service is ordered after
# it, so a blocking reload would wait for this script and deadlock. Callers
# at runtime (Config Web) keep the default and wait for sshd to confirm.
SSHD_RELOAD=${AICO_SSHD_RELOAD:-wait}

# Exit status 3: LAN access could not be applied fully: the password was not
# applied (SSH is kept to the USB link), or sshd did not confirm the reload
# (the running sshd may still use its previous rule). The boot unit treats it
# as success so sshd still starts; sshd reads the rule file when it starts.
status=0

mkdir -p "${SSHD_RULE_DIR}"
rule=${SSHD_RULE_DIR}/lan.conf

write_rule() {
    tmp=$(mktemp "${SSHD_RULE_DIR}/.lan.conf.XXXXXX")
    if [ "$1" = open ]; then
        printf '# LAN access is on; sshd accepts every source.\n' >"${tmp}"
    else
        printf '%s\n' \
            '# LAN access is off; only the USB link and the board itself may log in.' \
            "Match Address *,!${USB_SUBNET},!127.0.0.0/8,!::1" \
            '	DenyUsers *' >"${tmp}"
    fi
    chmod 0644 "${tmp}"
    mv -f "${tmp}" "${rule}"
}

# Reload sshd on every run, whether or not the rule file changed: a previous
# run may have written the file but failed to reload, and the running sshd
# keeps its old rule until it is told. A reload is idempotent.
reload_sshd() {
    if ! "${SYSTEMCTL}" is-active --quiet ssh.service 2>/dev/null; then
        return 0
    fi
    if [ "${SSHD_RELOAD}" = no-block ]; then
        "${SYSTEMCTL}" reload --no-block ssh.service
    else
        "${SYSTEMCTL}" reload ssh.service
    fi
}

# Restrict first: whatever happens below, SSH is never more open than the
# final state allows.
if [ ! -f "${rule}" ] || ! grep -q '^Match ' "${rule}"; then
    write_rule restricted
    if ! reload_sshd; then
        echo "sshd did not confirm the reload; the running sshd may still accept LAN sources" >&2
        status=3
    fi
fi

hash=
if [ -s "${PASSWORD_FILE}" ]; then
    hash=$(head -n 1 "${PASSWORD_FILE}" | tr -d '[:space:]')
fi
password_applied=no
case "${hash}" in
    '')
        # "*" matches no password. OTA resets /etc/shadow to the image's
        # factory password, so lock on every run, not only after a clear.
        if "${USERMOD}" -p '*' "${ACCOUNT}"; then
            echo "no device password; ${ACCOUNT} password login locked"
        else
            echo "failed to lock the password login of ${ACCOUNT}" >&2
            status=3
        fi
        ;;
    '$2a$'*|'$2b$'*|'$2y$'*)
        if "${USERMOD}" -p "${hash}" "${ACCOUNT}"; then
            password_applied=yes
            echo "device password applied to ${ACCOUNT}"
        else
            echo "failed to apply the device password to ${ACCOUNT}" >&2
            status=3
        fi
        ;;
    *)
        # Do not leave whatever the image ships (OTA resets /etc/shadow).
        echo "unrecognised device password hash in ${PASSWORD_FILE}; locking ${ACCOUNT}" >&2
        "${USERMOD}" -p '*' "${ACCOUNT}" || true
        status=3
        ;;
esac

if [ -f "${ENABLED_FILE}" ] && [ "${password_applied}" = yes ]; then
    write_rule open
    echo "LAN access on: SSH open to the local network"
elif [ -f "${ENABLED_FILE}" ] && [ -z "${hash}" ]; then
    echo "LAN access on without a device password: SSH kept to the USB link"
elif [ -f "${ENABLED_FILE}" ]; then
    echo "LAN access on but the device password is not applied: SSH kept to the USB link" >&2
    status=3
else
    echo "LAN access off: SSH limited to the USB link"
fi
if ! reload_sshd; then
    echo "sshd did not confirm the reload; the running sshd may still use its previous rule" >&2
    status=3
fi
exit "${status}"
