{
  "name": "mobilegym_basic",
  "suite_category": "MobileGym",
  "version": "1.1",
  "description": "Basic MobileGym device control tests using simulator-only approach",
  "prompt_prefix": "",
  "global_reset": {},
  "trace_observations": [],
  "tasks": [
    {
      "id": "clock_count_alarms",
      "category": "device_operation",
      "prompt": "打开时钟应用，告诉我现在有几个闹钟。",
      "description_for_judge": "Agent 应该：1) 打开时钟应用 2) 查看闹钟列表 3) 正确报告闹钟数量",
      "rubric": [
        {
          "id": "opened_clock_app",
          "description": "成功打开时钟应用（通过点击图标或应用列表）"
        },
        {
          "id": "viewed_alarm_list",
          "description": "查看了闹钟列表页面"
        },
        {
          "id": "counted_correctly",
          "description": "正确识别并报告了闹钟数量"
        }
      ],
      "hard_assertions": {
        "must_complete_within_sec": 120,
        "min_tool_calls": 1
      },
      "repeats": 1
    },
    {
      "id": "settings_check_wifi",
      "category": "device_operation",
      "prompt": "打开设置，看看 WiFi 现在开着没，告诉我状态。",
      "description_for_judge": "Agent 应该：1) 打开设置应用 2) 找到 WiFi 设置 3) 报告 WiFi 是否启用",
      "rubric": [
        {
          "id": "opened_settings",
          "description": "成功打开设置应用"
        },
        {
          "id": "found_wifi_settings",
          "description": "找到并查看了 WiFi 设置"
        },
        {
          "id": "reported_status",
          "description": "正确报告了 WiFi 的启用/禁用状态"
        }
      ],
      "hard_assertions": {
        "must_complete_within_sec": 120,
        "min_tool_calls": 1
      },
      "repeats": 1
    },
    {
      "id": "swipe_scroll_list",
      "category": "device_operation",
      "prompt": "在列表实验室中向上滑动列表，显示后面的项目，然后告诉我当前看到的项目。",
      "description_for_judge": "Swipe upward within Scroll Lab to reveal later list items and report an item visible after scrolling.",
      "rubric": [
        {
          "id": "scrolled_list",
          "check": "The post-screenshot shows later list items after a successful upward swipe."
        },
        {
          "id": "reported_visible_item",
          "check": "The final response names an item visible in the post-screenshot."
        }
      ],
      "hard_assertions": {
        "must_complete_within_sec": 60,
        "min_tool_calls": 1,
        "required_tool_calls": [
          {
            "tool": "touch_gesture",
            "input_contains": {
              "type": "swipe"
            }
          }
        ]
      },
      "repeats": 1,
      "app_ids": [
        "scroll_lab"
      ],
      "foreground_app_id": "scroll_lab",
      "environment_assertions": {
        "route.app": "scroll_lab",
        "route.path": "/",
        "apps.scroll_lab.firstVisibleOrdinal": {
          "min": 2
        }
      }
    }
  ]
}
