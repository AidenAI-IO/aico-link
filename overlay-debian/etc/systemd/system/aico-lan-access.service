[Unit]
Description=Apply Aico Link LAN access to SSH and the aico login account
Requires=aico-userdata-migrate.service
After=aico-userdata-migrate.service
Before=ssh.service aico-ttyd.service

[Service]
Type=oneshot
# ssh.service is ordered after this unit; waiting for its reload would deadlock.
Environment=AICO_SSHD_RELOAD=no-block
ExecStart=/usr/lib/aico/aico-lan-access-sync
SuccessExitStatus=3
RemainAfterExit=yes
TimeoutStartSec=30s

[Install]
WantedBy=multi-user.target
