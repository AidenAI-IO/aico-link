{
  "format": 1,
  "include": [
    "etc/aico/**",
    "etc/default/aico-*",
    "etc/aico_*.conf",
    "etc/locale.conf",
    "etc/profile.d/aico-*.sh",
    "etc/sudoers.d/*-aico-*",
    "etc/ssh/sshrc",
    "etc/ssh/sshd_config.d/*-aico.conf",
    "etc/dnsmasq.d/usb0.conf",
    "etc/dnsmasq.d/aico*.conf",
    "etc/systemd/network/20-wlan0.network",
    "etc/systemd/network/30-usb0.network",
    "etc/systemd/network/*-aico-*.network",
    "etc/systemd/journald.conf.d/*-aico.conf",
    "etc/systemd/system/aico*.service",
    "etc/systemd/system/aico*.path",
    "etc/systemd/system/aico*.timer",
    "etc/systemd/system/aico.target",
    "etc/systemd/system/*.service.d/*-aico.conf",
    "etc/systemd/system/*.device.d/*-aico-optional.conf",
    "etc/tmpfiles.d/aico*.conf",
    "etc/udev/rules.d/*-aico-*.rules",
    "usr/lib/aico/aico-*",
    "usr/share/aico/hdmi/*.hex",
    "usr/lib/systemd/system-shutdown/aico-mcu-shutdown"
  ],
  "exclude": [
    "usr/lib/aico/aico-apt-source",
    "usr/lib/aico/aico-bluetooth-prepare",
    "usr/lib/aico/aico-machine-id-provision",
    "usr/lib/aico/aico-media-modules",
    "usr/lib/aico/aico-ota-*",
    "usr/lib/aico/aico-root-home",
    "usr/lib/aico/aico-rootfs-grow",
    "usr/lib/aico/aico-slot-resolve",
    "usr/lib/aico/aico-ssh-identity",
    "usr/lib/aico/aico-user-home",
    "usr/lib/aico/aico-userdata-migrate",
    "usr/lib/aico/aico-wifi-driver",
    "usr/lib/aico/aico-wifi-prepare",
    "etc/systemd/system/aico-environment.service",
    "etc/systemd/system/aico-machine-id.service",
    "etc/systemd/system/aico-media-modules.service",
    "etc/systemd/system/aico-ota-*",
    "etc/systemd/system/aico-platform-ldconfig.service",
    "etc/systemd/system/aico-root-home.service",
    "etc/systemd/system/aico-rootfs-grow.service",
    "etc/systemd/system/aico-slot-resolve.service",
    "etc/systemd/system/aico-ssh-identity.service",
    "etc/systemd/system/aico-user-home.service",
    "etc/systemd/system/aico-userdata-migrate.service",
    "etc/systemd/system/aico-wifi-driver.service"
  ],
  "live": [
    "etc/ssh/sshrc",
    "etc/profile.d/*",
    "etc/sudoers.d/*",
    "etc/locale.conf",
    "etc/aico_audio_service.conf",
    "etc/aico_ble_service.conf",
    "etc/aico_frame_service.conf",
    "etc/tmpfiles.d/aico.conf",
    "etc/systemd/system/aico-agent.service",
    "etc/systemd/system/aico-audio.service",
    "etc/systemd/system/aico-ble.service",
    "etc/systemd/system/aico-config-web.service",
    "etc/systemd/system/aico-frame.service",
    "etc/systemd/system/aico-mcu-event.service",
    "etc/systemd/system/aico-ttyd.service",
    "etc/systemd/system/aico-wifi-proxy*",
    "usr/lib/aico/aico-agent-control",
    "usr/lib/aico/aico-feature-enabled",
    "usr/lib/aico/aico-frame-control",
    "usr/lib/aico/aico-frame-start",
    "usr/lib/aico/aico-hdmi-mode",
    "usr/lib/aico/aico-log.sh",
    "usr/lib/aico/aico-managed-env-run",
    "usr/lib/aico/aico-python-prepare",
    "usr/lib/aico/aico-ssh-session-tty",
    "usr/lib/aico/aico-ttyd-*",
    "usr/lib/aico/aico-wifi-proxy-*",
    "usr/share/aico/hdmi/*.hex",
    "usr/lib/systemd/system-shutdown/aico-mcu-shutdown"
  ]
}
