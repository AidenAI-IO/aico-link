[Unit]
Description=Aico Link audio capture and playback service
Requires=aico-environment.service aico-media-modules.service aico-audio-mixer.service
After=aico-environment.service aico-media-modules.service aico-audio-mixer.service sound.target
StartLimitIntervalSec=60s
StartLimitBurst=5
ConditionPathExists=/usr/lib/aico/audio_service

[Service]
Type=simple
Group=aico
SupplementaryGroups=audio video
EnvironmentFile=/etc/aico_boot.conf
EnvironmentFile=/etc/aico_audio_service.conf
EnvironmentFile=/run/aico/system.env
ExecCondition=/usr/lib/aico/aico-feature-enabled ENABLE_AUDIO_SERVICE
RuntimeDirectory=audio_service
LogsDirectory=audio_service
ExecStartPre=/usr/bin/install -d -m 0755 /userdata/audio_service
ExecStart=/usr/lib/aico/audio_service --socket ${SOCKET_PATH} --volume-state ${VOLUME_STATE_PATH}
Restart=on-failure
RestartSec=2s
TimeoutStartSec=20s
TimeoutStopSec=10s
LimitRTPRIO=10
StandardOutput=append:/var/log/audio_service/audio_service.log
StandardError=append:/var/log/audio_service/audio_service.log

[Install]
WantedBy=multi-user.target
