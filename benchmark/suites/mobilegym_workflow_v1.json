{
  "name": "mobilegym_workflow_v1",
  "suite_category": "MobileGym",
  "version": "1.2",
  "description": "Three experimental user workflows: edit and reopen a note, create and reopen a contact, and transfer a note into a contact. Manual only until reference UI replay validates the operation path; not a validated phone capability baseline.",
  "prompt_prefix": "",
  "global_reset": {},
  "trace_observations": [
    {
      "id": "skill_read_device_operator",
      "description": "Agent loaded device-operator before UI operation (informational only).",
      "skill_name": "device-operator"
    }
  ],
  "tasks": [
    {
      "id": "note_replace_one_item",
      "category": "device_operation",
      "platforms": [
        "android"
      ],
      "app_ids": [
        "notes"
      ],
      "initial_environment_state": {
        "apps": {
          "notes": {
            "notes": [
              {
                "id": "note-shopping",
                "title": "Shopping list",
                "content": "Milk\nEggs\nRice",
                "updatedAt": 1770000000000,
                "folderId": "unfiled",
                "pinned": false,
                "locked": false,
                "isPrivate": false,
                "trashedAt": null
              },
              {
                "id": "note-guard",
                "title": "Travel checklist",
                "content": "Passport\nCharger\nTickets",
                "updatedAt": 1770000000000,
                "folderId": "unfiled",
                "pinned": false,
                "locked": false,
                "isPrivate": false,
                "trashedAt": null
              }
            ]
          }
        }
      },
      "prompt": "Open Notes and replace Eggs with Tea in Shopping list, preserving its title and the other two lines. Save, return to the note list, then reopen Shopping list and verify the complete body. Leave every other note unchanged.",
      "description_for_judge": "Complete the requested task using screenshots and device UI tools. Judge the persisted outcome and the trace, not an unsupported claim of success.",
      "rubric": [
        {
          "id": "edited_content",
          "description": "Persist Milk, Tea, and Rice on separate lines with the original title. Replacing the whole body correctly is acceptable."
        },
        {
          "id": "preserved_notes",
          "description": "Keep the other note and target metadata intact; do not create a duplicate."
        },
        {
          "id": "reopened_and_verified",
          "description": "The trace shows saving the edited or created record, returning to its list, reopening that same record, and inspecting its saved contents. A final success claim or final-state assertion alone does not satisfy this check."
        }
      ],
      "environment_assertions": {
        "apps.notes.notes": {
          "$records": [
            {
              "id": "note-shopping",
              "title": "Shopping list",
              "content": "Milk\nTea\nRice",
              "folderId": "unfiled",
              "pinned": false,
              "locked": false,
              "isPrivate": false,
              "trashedAt": null
            },
            {
              "id": "note-guard",
              "title": "Travel checklist",
              "content": "Passport\nCharger\nTickets",
              "updatedAt": 1770000000000,
              "folderId": "unfiled",
              "pinned": false,
              "locked": false,
              "isPrivate": false,
              "trashedAt": null
            }
          ]
        }
      },
      "hard_assertions": {
        "forbidden_tools": [
          "request_user_action"
        ],
        "min_tool_calls": 2,
        "must_complete_within_sec": 360
      },
      "repeats": 1
    },
