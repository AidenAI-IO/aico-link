[Unit]
Description=Process pending Aico Link A/B OTA health state
Requires=aico-userdata-migrate.service aico-environment.service userdata-ota.mount
Requires=aico-ota-health-marker.service
After=aico-userdata-migrate.service aico-environment.service userdata-ota.mount
After=aico-ota-health-marker.service
ConditionPathExists=/usr/lib/aico/ota

[Service]
Type=oneshot
EnvironmentFile=/run/aico/system.env
LogsDirectory=ota
ExecStart=/usr/lib/aico/ota --config /userdata/debian/ota/config.json health
# The OTA command waits up to five minutes by default; keep an outer bound for
# interruptible storage stalls while leaving room for the metadata commit.
TimeoutStartSec=10min
StandardOutput=append:/var/log/ota/ota.log
StandardError=append:/var/log/ota/ota.log

[Install]
WantedBy=multi-user.target
