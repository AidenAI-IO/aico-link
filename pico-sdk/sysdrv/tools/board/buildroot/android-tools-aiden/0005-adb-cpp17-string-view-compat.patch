--- /dev/null
+++ b/vendor/core/adb/adb_string_view_compat.h
@@ -0,0 +1,30 @@
+// Aiden: C++17 compatibility for std::string_view::starts_with/ends_with
+//
+// These methods were added in C++20. GCC 8.3 libstdc++ only supports C++17,
+// so this header provides equivalent free functions that the patched adb
+// source files call via adb_compat::starts_with/ends_with.
+
+#pragma once
+
+#include <string_view>
+
+namespace adb_compat {
+
+inline bool starts_with(std::string_view sv, std::string_view prefix) noexcept {
+    return sv.size() >= prefix.size() && sv.substr(0, prefix.size()) == prefix;
+}
+
+inline bool starts_with(std::string_view sv, char c) noexcept {
+    return !sv.empty() && sv.front() == c;
+}
+
+inline bool ends_with(std::string_view sv, std::string_view suffix) noexcept {
+    return sv.size() >= suffix.size() &&
+           sv.substr(sv.size() - suffix.size()) == suffix;
+}
+
+inline bool ends_with(std::string_view sv, char c) noexcept {
+    return !sv.empty() && sv.back() == c;
+}
+
+} // namespace adb_compat
