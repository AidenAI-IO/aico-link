# Aico agent daemon image with China mirror defaults.

FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/golang:1.23 AS agent-daemon-builder

# China-mirror image: reaches the Huawei registry and goproxy.cn directly, so
# it never uses an HTTP proxy.
WORKDIR /build
ENV GOPROXY=https://goproxy.cn,direct \
    GOTOOLCHAIN=auto

COPY src/agent/go.mod src/agent/go.sum ./
RUN go mod download

COPY src/agent/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o daemon ./cmd/daemon

# The Agent's shell runs inside this container. The controller ships Python 3.13
# with only the standard library, so the runtime matches it: shell commands that
# read $AICO_SCREENSHOT_PPM work the same here as on the board.
FROM swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/python:3.13-slim AS agent-daemon-runtime

COPY --from=agent-daemon-builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=agent-daemon-builder /build/daemon /usr/local/bin/daemon
COPY benchmark/docker/agent-daemon-entrypoint.sh /usr/local/bin/agent-daemon-entrypoint
# The controller has python3 at /usr/bin/python3; keep that path working here.
RUN ln -sf /usr/local/bin/python3 /usr/bin/python3
RUN chmod +x /usr/local/bin/agent-daemon-entrypoint
RUN useradd --system --create-home --uid 10001 agent && \
    mkdir -p /app && chown -R agent:agent /app

WORKDIR /app
EXPOSE 8080
USER agent

CMD ["agent-daemon-entrypoint"]
