[Unit]
# This mount starts after userdata migration, which runs after local-fs.target.
DefaultDependencies=no
Conflicts=umount.target
Before=umount.target
Description=Persistent user uploads and Agent outputs
Requires=aico-share-prepare.service
After=aico-share-prepare.service
Before=aico-agent.service

[Mount]
What=/userdata/share
Where=/share
Type=none
Options=bind
