[Unit]
Description=Attach the Aico Link AIC8800 Bluetooth UART
Requires=aico-wifi-driver.service
After=aico-wifi-driver.service dev-ttyS0.device
Wants=dev-ttyS0.device
Before=bluetooth.service
ConditionPathExists=/dev/ttyS0
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/aico_boot.conf
ExecCondition=/usr/lib/aico/aico-feature-enabled ENABLE_BLUETOOTH_HCI
ExecStartPre=/usr/lib/aico/aico-bluetooth-prepare
ExecStart=/usr/bin/hciattach -n -s 1500000 /dev/ttyS0 any 1500000 flow nosleep
ExecStartPost=/usr/lib/aico/aico-bluetooth-hci-wait
Restart=on-failure
RestartSec=2s
TimeoutStartSec=25s
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
