From: aiden build <build@aiden.local>
Subject: [PATCH] boringssl: skip ssl/test subdirectory and run_tests target

The adb client build only links libcrypto/libssl; it does not run
BoringSSL's test suite. The vendored tarball prunes ssl/test/ (1.7M of
test tooling) to keep the tarball smaller, but BoringSSL's top-level
CMakeLists.txt unconditionally calls add_subdirectory(ssl/test) and
defines a run_tests target that references bssl_shim/handshaker (built
in ssl/test/). Comment out both so the client-only build succeeds
without the test tree.

Aiden-local patch (not from upstream nmeum/android-tools).
---
--- a/vendor/boringssl/CMakeLists.txt
+++ b/vendor/boringssl/CMakeLists.txt
@@ -584,7 +584,7 @@

 add_subdirectory(crypto)
 add_subdirectory(ssl)
-add_subdirectory(ssl/test)
+# add_subdirectory(ssl/test)  # Aiden: pruned from vendored tarball (client-only build)
 add_subdirectory(tool)
 add_subdirectory(util/fipstools/cavp)
 add_subdirectory(util/fipstools/acvp/modulewrapper)
@@ -602,22 +602,23 @@
   add_subdirectory(fuzz)
 endif()

-if(NOT ${CMAKE_VERSION} VERSION_LESS "3.2")
-  # USES_TERMINAL is only available in CMake 3.2 or later.
-  set(MAYBE_USES_TERMINAL USES_TERMINAL)
-endif()
-
-if(UNIX AND NOT APPLE AND NOT ANDROID)
-  set(HANDSHAKER_ARGS "-handshaker-path" $<TARGET_FILE:handshaker>)
-endif()
-
-add_custom_target(
-    run_tests
-    COMMAND ${GO_EXECUTABLE} run util/all_tests.go -build-dir
-            ${CMAKE_BINARY_DIR}
-    COMMAND cd ssl/test/runner &&
-            ${GO_EXECUTABLE} test -shim-path $<TARGET_FILE:bssl_shim>
-              ${HANDSHAKER_ARGS} ${RUNNER_ARGS}
-    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}
-    DEPENDS all_tests bssl_shim handshaker
-    ${MAYBE_USES_TERMINAL})
