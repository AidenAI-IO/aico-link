enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable wpa_supplicant@wlan0.service
enable ssh.service
enable serial-getty@ttyFIQ0.service
enable aico-slot-resolve.service
enable aico-rootfs-grow.service
enable userdata.mount
enable userdata-ota.mount
enable aico-ota-recovery.service
enable aico-userdata-migrate.service
enable aico-machine-id.service
enable aico-root-home.service
enable aico-ssh-identity.service
enable aico-platform-ldconfig.service
enable aico-environment.service
enable aico-zram.service
enable aico-swap.service
enable aico-media-modules.service
enable aico-wifi-driver.service
enable aico-bluetooth-state.service
enable aico-bluetooth-attach.service
enable bluetooth.service
enable aico-rtc.service
enable aico-boot-timeline.service
enable aico-ota-health-marker.service
enable aico-ota-health.service
enable aico.target
disable dnsmasq.service
disable wpa_supplicant.service
disable ssh.socket
disable rsync.service
disable systemd-networkd-wait-online.service
disable e2scrub_all.timer
disable e2scrub_reap.service
disable apt-daily.service
disable apt-daily.timer
disable apt-daily-upgrade.service
disable apt-daily-upgrade.timer
