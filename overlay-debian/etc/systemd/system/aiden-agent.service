[Unit]
Description=Aiden device agent
Requires=aiden-userdata-migrate.service aiden-environment.service aiden-boot-timeline-init.service
Requires=aiden-wifi-proxy.service
Requires=aiden-backup-recover.service
Wants=aiden-frame.service aiden-audio.service aiden-ble.service
After=aiden-userdata-migrate.service aiden-environment.service aiden-boot-timeline-init.service
After=aiden-frame.service aiden-audio.service aiden-ble.service aiden-wifi-proxy.service time-set.target
After=aiden-backup-recover.service
StartLimitIntervalSec=120s
StartLimitBurst=5
ConditionPathExists=/usr/lib/aiden/agent
# A restore transaction that could not be finished or rolled back at boot
# leaves this marker; the Agent must not run on possibly inconsistent data.
ConditionPathExists=!/run/aiden/backup/recovery.failed

[Service]
Type=simple
EnvironmentFile=/etc/aiden_boot.conf
EnvironmentFile=/run/aiden/system.env
Environment=AIDEN_MCU_SERVICE_SOCKET=/run/mcu_service/mcu_service.sock
Environment=AIDEN_BLE_SERVICE_SOCKET=/run/ble_service/ble_service.sock
Environment=AIDEN_USB_COMPOSITE_REFRESH_COMMAND=/usr/lib/aiden/aiden-usb-ecm-watchdog
Environment=PYTHONUSERBASE=/userdata/agent/python
Environment=PIP_USER=1
Environment=PIP_NO_CACHE_DIR=1
Environment=PIP_DISABLE_PIP_VERSION_CHECK=1
Environment=PIP_BREAK_SYSTEM_PACKAGES=1
ExecCondition=/usr/lib/aiden/aiden-feature-enabled ENABLE_AGENT
RuntimeDirectory=agent
ExecStartPre=/usr/lib/aiden/aiden-python-prepare
ExecStart=/usr/lib/aiden/aiden-managed-env-run /usr/lib/aiden/agent -dir /userdata/agent -addr 0.0.0.0:8080
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=10s
StandardOutput=append:/userdata/agent/log/agent.log
StandardError=append:/userdata/agent/log/agent.log

[Install]
WantedBy=multi-user.target
