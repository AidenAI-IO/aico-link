[Unit]
Description=Aico Link OTA workspace
DefaultDependencies=no
Requires=userdata.mount aico-slot-resolve.service aico-rootfs-grow.service
After=userdata.mount aico-rootfs-grow.service
Before=local-fs.target

[Mount]
What=/dev/mmcblk0p10
Where=/userdata/ota
Type=ext4
Options=noatime,nosuid,nodev
TimeoutSec=20s

[Install]
WantedBy=local-fs.target
