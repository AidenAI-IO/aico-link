[Unit]
Description=Aico Link persistent userdata
DefaultDependencies=no
Requires=aico-slot-resolve.service aico-rootfs-grow.service
After=aico-slot-resolve.service aico-rootfs-grow.service
Before=local-fs.target

[Mount]
What=/dev/disk/by-label/userdata
Where=/userdata
Type=ext4
Options=noatime
TimeoutSec=20s

[Install]
WantedBy=local-fs.target
