#!/usr/bin/python3
"""Select the persistent RK628 input mode and restart capture to apply it."""

import argparse
import fcntl
import os
from pathlib import Path
import subprocess
import sys
import tempfile

MODE_FILE = Path("/userdata/system/hdmi-mode")
EDID_DIR = Path("/usr/share/aiden/hdmi")
MODES = ("1080p60", "1080p30")


def read_mode():
    try:
        mode = MODE_FILE.read_text().strip()
    except FileNotFoundError:
        return "1080p60", "default"
    if mode not in MODES:
        raise ValueError(f"Invalid saved mode in {MODE_FILE}")
    return mode, "saved"


def save_mode(mode):
    # Validate installed assets before changing the persistent selection.
    edid = bytes.fromhex((EDID_DIR / f"hdmi_{mode}_cta.hex").read_text())
    if (len(edid) != 256 or edid[:8] != bytes.fromhex("00ffffffffffff00")
            or edid[126] != 1 or any(sum(edid[i:i + 128]) % 256 for i in (0, 128))):
        raise ValueError(f"Invalid installed EDID for {mode}")
    MODE_FILE.parent.mkdir(parents=True, exist_ok=True)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=MODE_FILE.parent,
                                         prefix=".hdmi-mode-", delete=False) as stream:
            temporary = Path(stream.name)
            os.fchmod(stream.fileno(), 0o644)
            stream.write(mode + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, MODE_FILE)
        directory = os.open(MODE_FILE.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("mode", choices=(*MODES, "status"), nargs="?", default="status")
    args = parser.parse_args()
    if args.mode == "status":
        mode, origin = read_mode()
        print(f"Configured HDMI mode: {mode} ({origin})")
        return 0
    if os.geteuid() != 0:
        parser.error("changing the HDMI mode requires sudo")
    # Serialize selection and restart; this lock is separate from the service's
    # video-device lock and is never held by the capture process.
    with open("/run/lock/aiden-hdmi-mode.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        save_mode(args.mode)
        result = subprocess.run(["systemctl", "restart", "aiden-frame.service"], check=False)
        if result.returncode:
            print(f"Saved {args.mode}, but capture restart failed. Run "
                  "sudo systemctl restart aiden-frame.service to retry.", file=sys.stderr)
            return 1
    print(f"Saved HDMI mode: {args.mode}; capture service restarted. "
          "The selection survives reboot. Allow about 30 seconds for source negotiation.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"aiden-hdmi-mode: {error}", file=sys.stderr)
        sys.exit(1)
