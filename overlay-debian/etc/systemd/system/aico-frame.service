[Unit]
Description=Aico Link frame capture service
Requires=aico-userdata-migrate.service aico-environment.service aico-media-modules.service
After=aico-userdata-migrate.service aico-environment.service aico-media-modules.service
# HDMI input may appear well after boot. Retry indefinitely, with RestartSec
# providing the retry backoff.
StartLimitIntervalSec=0
ConditionPathExists=/usr/lib/aico/frame_service

[Service]
Type=simple
Group=aico
SupplementaryGroups=audio video
EnvironmentFile=/etc/aico_boot.conf
EnvironmentFile=/etc/aico_frame_service.conf
EnvironmentFile=/run/aico/system.env
ExecCondition=/usr/lib/aico/aico-feature-enabled ENABLE_FRAME_SERVICE
RuntimeDirectory=frame_service
LogsDirectory=frame_service
ExecStart=/usr/lib/aico/aico-frame-start
Restart=on-failure
RestartSec=2s
TimeoutStartSec=35s
TimeoutStopSec=10s
StandardOutput=append:/var/log/frame_service/frame_service.log
StandardError=append:/var/log/frame_service/frame_service.log

[Install]
WantedBy=multi-user.target
