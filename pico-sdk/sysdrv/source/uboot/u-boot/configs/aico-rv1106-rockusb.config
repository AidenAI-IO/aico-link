# Serve the BOOT-key download from U-Boot's RockUSB gadget instead of falling
# back to the BootROM, so the HS PHY trim is under our control while flashing.
# Keep the board's non-DM DWC3 gadget path: board_usb_init() drives dwc3 directly.
CONFIG_CMD_ROCKUSB=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_GADGET_DUALSPEED=y
CONFIG_USB_GADGET_MANUFACTURER="Rockchip"
CONFIG_USB_GADGET_PRODUCT_NUM=0x110c
CONFIG_USB_GADGET_VENDOR_NUM=0x2207
CONFIG_USB_GADGET_VBUS_DRAW=2
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
# CONFIG_USB_DWC3_HOST is not set
# DM_USB returns via Kconfig once CONFIG_USB=y; the gadget path stays non-DM.
# CONFIG_DM_USB_GADGET is not set
# CONFIG_SPL_DM_USB is not set
# CONFIG_SPL_DM_USB_GADGET is not set
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_UDP_FUNCTION_FASTBOOT is not set
# CONFIG_USB_FUNCTION_DFU is not set
# CONFIG_USB_FUNCTION_SDP is not set
# CONFIG_USB_ETHER is not set
