[Unit]
Description=Aiden MCU UART and power service
After=dev-ttyS5.device
Before=aiden-agent.service
ConditionPathExists=/dev/ttyS5
ConditionPathExists=/usr/lib/aiden/mcu_service

[Service]
Type=simple
User=root
Group=aiden
RuntimeDirectory=mcu_service
RuntimeDirectoryMode=0750
ExecStart=/usr/lib/aiden/mcu_service --port /dev/ttyS5
Restart=on-failure
RestartSec=1s
TimeoutStopSec=2s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=aiden.target
