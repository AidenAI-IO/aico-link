#!/bin/sh
set -u

if [ -n "${AICO_AMIXER_BIN:-}" ]; then
    amixer_bin=${AICO_AMIXER_BIN}
else
    amixer_bin=$(command -v amixer 2>/dev/null || true)
fi

if [ -z "${amixer_bin}" ] || [ ! -x "${amixer_bin}" ]; then
    echo "aico-audio-mixer: amixer is not available" >&2
    exit 1
fi

# The Pico Zero DTS names the card rv1106-acodec. ALSA removes punctuation
# when generating its ID, which stays stable when card indices change.
card=rv1106acodec

control_available() {
    for name in "$@"; do
        if "${amixer_bin}" -c "${card}" sget "${name}" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

required_controls_ready() {
    control_available 'ADC MIC Left Gain' &&
        control_available 'ADC MIC Right Gain' &&
        control_available 'ADC MICBIAS Voltage' &&
        control_available 'ADC Mode' &&
        control_available 'ADC ALC Left' 'ADC ALC Left Volume' &&
        control_available 'ADC ALC Right' 'ADC ALC Right Volume'
}

if command -v udevadm >/dev/null 2>&1; then
    udevadm settle --timeout=10 >/dev/null 2>&1 || true
fi

# The codec controls are created asynchronously after snd-soc-rv1106 loads.
ready=0
attempt=0
while [ "${attempt}" -lt 40 ]; do
    if required_controls_ready; then
        ready=1
        break
    fi
    attempt=$((attempt + 1))
    sleep 0.25
done
if [ "${ready}" -ne 1 ]; then
    echo "aico-audio-mixer: required controls on ${card} did not become ready" >&2
    exit 1
fi

set_control() {
    value=$1
    shift
    for name in "$@"; do
        if "${amixer_bin}" -c "${card}" -q set "${name}" "${value}" >/dev/null 2>&1; then
            return 0
        fi
    done
    echo "aico-audio-mixer: failed to set $* to ${value}" >&2
    return 1
}

status=0
# These settings were previously applied by the Buildroot S60micinit script.
set_control 3 'ADC MIC Left Gain' || status=1
set_control 3 'ADC MIC Right Gain' || status=1
set_control VREFx0_975 'ADC MICBIAS Voltage' || status=1
set_control SingadcL 'ADC Mode' || status=1
# Older kernels expose the ALC controls without the Volume suffix.
set_control 26 'ADC ALC Left' 'ADC ALC Left Volume' || status=1
set_control 26 'ADC ALC Right' 'ADC ALC Right Volume' || status=1

if [ "${status}" -ne 0 ]; then
    exit 1
fi

echo "aico-audio-mixer: microphone controls initialized" >&2
